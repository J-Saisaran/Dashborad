    "test:phase5": "tsx tests/api_phase5.test.ts",
    "test:phase6": "tsx tests/activity.test.ts",
    "test:phase7": "tsx tests/websocket.test.ts",
    "test:phase8": "tsx tests/missed_events.test.ts",
    "test:phase9": "tsx tests/notifications.test.ts",
    "test:phase10": "tsx tests/overdue_job.test.ts",
    "test:phase11": "tsx tests/dashboard.test.ts",
    "test:phase12": "tsx tests/seed.test.ts",
    "test:e2e": "tsx tests/e2e_integration.test.ts",
    "test": "tsx tests/auth.test.ts && tsx tests/api_auth.test.ts && tsx tests/authorization.test.ts && tsx tests/api_phase5.test.ts && tsx tests/activity.test.ts && tsx tests/websocket.test.ts && tsx tests/missed_events.test.ts && tsx tests/notifications.test.ts && tsx tests/overdue_job.test.ts && tsx tests/dashboard.test.ts && tsx tests/seed.test.ts && tsx tests/e2e_integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
