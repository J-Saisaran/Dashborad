# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=velozity_dashboard
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/velozity_dashboard?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Client URL (for CORS and WebSocket origin verification)
CLIENT_URL=http://localhost:5173
